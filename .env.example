# ================================
# SUPABASE
# ================================
# URL do seu projeto Supabase (ex: https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Chave anônima (pública) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Chave de serviço do Supabase (PRIVADA - nunca exponha no frontend)
# Necessária para operações de tracking, webhooks e operações administrativas
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ================================
# STRIPE
# ================================
# Chave secreta do Stripe (PRIVADA)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Chave pública do Stripe (pode ser exposta no frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Secret do webhook do Stripe (obtido ao configurar webhook no dashboard do Stripe)
# Necessário para validar assinatura dos eventos do Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ================================
# APLICAÇÃO
# ================================
# URL base do site (usado para redirects do Stripe e links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================================
# CRON JOBS (Opcional)
# ================================
# Token secreto para proteger endpoints de CRON
# Use um valor aleatório forte (ex: openssl rand -hex 32)
CRON_SECRET=your_random_cron_secret_here

# ================================
# TELEGRAM (Configuração via Dashboard)
# ================================
# Tokens do Telegram são configurados diretamente no dashboard
# Não é necessário configurar aqui

# ================================
# META/FACEBOOK CAPI (Configuração via Dashboard)
# ================================
# Pixels e tokens CAPI são configurados diretamente no dashboard
# Não é necessário configurar aqui

# ================================
# DESENVOLVIMENTO
# ================================
# Modo de desenvolvimento do Next.js
NODE_ENV=development
